{
    "appId": "fslanat-app",
    "appVersion": "0.9",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/products/mris",
    "maxMinutes": 240,
    "name": "fslanat",
    "parameterSet": {
        "appArgs": [
            {
                "arg": "--input-dirs /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/bids/NStravel1 /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/bids/NStravel2",
                "name": "INPUT_DIRS"
            },
            {
                "arg": "--output-dir NS_northsthore/fslanat/travel1 NS_northsthore/fslanat/travel2",
                "name": "OUTPUT_DIRS"
            },
            {
                "arg": "--n-workers 100",
                "name": "N_WORKERS"
            }
        ],
        "envVariables": [
            {
                "key": "FAILURE_LOG_DST",
                "value": "/corral-secure/projects/A2CPS/products/development/mris/logs/fslanat/"
            }
        ]
    },
    "subscriptions": [
        {
            "deliveryTargets": [
                {
                    "deliveryAddress": "",
                    "deliveryMethod": "WEBHOOK"
                }
            ],
            "description": "Message on Failure",
            "enabled": true,
            "eventCategoryFilter": "JOB_ERROR_MESSAGE"
        }
    ]
}