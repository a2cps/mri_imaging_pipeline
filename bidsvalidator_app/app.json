{
	"name": "{{ agave.username }}-{{ app.name }}",
	"version": "{{ app.version }}",
	"executionType": "HPC",
	"executionSystem": "{{ app.hpc_system}}",
	"parallelism": "SERIAL",
	"deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
	"deploymentSystem": "{{ app.storage_system}}",
	"defaultProcessorsPerNode": 1,
	"defaultNodeCount": 1,
	"defaultQueue": "{{ app.queue }}",
	"label": "BIDSVALIDATOR_TEST",
	"modules": ["load tacc-singularity", "unload xalt"],
	"shortDescription": "{{ app.description }}",
	"templatePath": "runner-template.sh",
	"testPath": "tester.sh",
	"inputs": [],
	"parameters": [{
			"id": "CONTAINER_IMAGE",
			"value": {
				"default": "{{ docker.organization }}/{{ docker.repo }}:{{ docker.tag }}",
				"description": "Container Image. Do not edit.",
				"type": "string",
				"visible": false,
				"required": true
			}
		},

		{
			"id": "BIDS_DIRECTORY",
			"details": {
				"argument": "",
				"showArgument": false,
				"description": "Path to BIDS directory"
			},
			"value": {
				"default": "/work/03372/yoh/stampede2/a2cps/data/northshore/bids/",
				"type": "string",
				"visible": true,
				"required": false
			}
		},
		{
			"id": "CONFIG_IGNORE",
			"details": {
				"argument": "--config.ignore=",
				"showArgument": true,
				"description": "Path to BIDS directory"
			},
			"value": {
				"default": "129",
				"type": "string",
				"visible": true,
				"required": false
			}
		}
	]
}
