{
  "checkpointable": false,
  "name": "{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "unload xalt",
    "load launcher",
    "load tacc-singularity",
    "load python3/3.9.2"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "06:00:00",
  "inputs": [],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "docker://{{ docker.namespace }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": true,
        "required": true,
        "order": 1000
      }
    },
    {
      "id": "A1",
      "value": {
        "default": "6",
        "visible": true,
        "type": "string",
        "required": false
      },
      "details": {
        "description": "extra parameter for batch file (e.g., number processors)",
        "argument": "--a1 ",
        "showArgument": false
      }
    },
    {
      "id": "BATCH",
      "value": {
        "default": "batch.m",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Batch file defining job to run",
        "argument": "-b ",
        "showArgument": false
      }
    },
    {
      "id": "BIND_DIR",
      "value": {
        "default": "/corral-secure/projects/A2CPS/",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Directory that is mounted into the container"
      }
    },
    {
      "id": "NIFTI",
      "value": {
        "default": "",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Anatomical image(s) to process, as space separated strings",
        "showArgument": false
      }
    },
    {
      "id": "OUTDIR",
      "value": {
        "default": "",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Space separated list of directories to which results will be written",
        "showArgument": false
      }
    }
  ],
  "outputs": []
}
