{
  "id": "maj-qsirecon-fsl_dtifit_app",
  "version": "1.5",
  "description": "Prepare QSIPrep outputs for FSL and run dtifit",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": [
    "SINGULARITY_RUN"
  ],
  "containerImage": "docker://micaceous/qsirecon-fsl_dtifit_app",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": true,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "secure.frontera",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemOutputDir": "${JobWorkingDir}",
    "execSystemLogicalQueue": "corralextra",
    "archiveSystemId": "secure.frontera",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/shared/maj/qsirecon-fsl_dtifit_app",
    "archiveOnAppError": false,
    "isMpi": false,
    "mpiCmd": null,
    "cmdPrefix": null,
    "parameterSet": {
      "appArgs": [
        {
          "name": "BIDSDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/bids/NStravel2"
        },
        {
          "name": "WORKDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "./work"
        },
        {
          "name": "QSIPREPDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/qsiprep_tests/derivatives/NS_northshore/NStravel2/qsiprep"
        },
        {
          "name": "OUTDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/qsirecon-fsl_dtifit_app/derivatives"
        },
        {
          "name": "PARTICIPANT_LABEL",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "sub-travel2"
        },
        {
          "name": "NTHREADS",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "8"
        },
        {
          "name": "MEMMB",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "32000"
        },
        {
          "name": "LICENSE",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/qsiprep_tests/code/license.txt"
        }
      ],
      "containerArgs": [
        {
          "name": "Container Mounts",
          "description": "Mount for TAP functions",
          "inputMode": "FIXED",
          "arg": "--bind /corral-secure/projects/A2CPS"
        }
      ],
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "description": "Scheduler profile for HPC clusters at TACC",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer"
        },
        {
          "name": "TAP Session Substring",
          "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
          "inputMode": "FIXED",
          "arg": "--job-name ${JobName}"
        },
        {
          "name": "TACC Allocation",
          "description": "The TACC allocation associated with this job execution",
          "inputMode": "FIXED",
          "arg": "-A A2CPS"
        }
      ],
      "envVariables": [],
      "archiveFilter": {
        "includes": [],
        "excludes": [
          "*out"
        ],
        "includeLaunchFiles": false
      }
    },
    "fileInputs": [],
    "fileInputArrays": [],
    "nodeCount": 1,
    "maxMinutes": 120,
    "subscriptions": [],
    "tags": []
  }
}