{
    "appId": "psadil-gift_app",
    "appVersion": "0.1",
    "cmdPrefix": "ibrun -n 1 apptainer run docker://psadil/gift_app:latest --help && ibrun -n 2",
    "execSystemLogicalQueue": "corralextra",
    "coresPerNode": 2,
    "maxMinutes": 180,
    "name": "gift-travel",
    "nodeCount": 1,
    "parameterSet": {
        "appArgs": [
            {
                "arg": "--input-dirs /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/fmriprep/NStravel1/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/fmriprep/NStravel2/fmriprep",
                "name": "INPUT_DIRS"
            },
            {
                "arg": "--output-dirs NS_northshore/gift/NStravel1 NS_northshore/gift/NStravel2",
                "name": "OUTPUT_DIRS"
            }
        ],
        "envVariables": [
            {
                "key": "FAILURE_LOG_DST",
                "value": "logs/gift/"
            },
            {
                "key": "MIN_ARCHIVE_DURATION",
                "value": "180"
            }
        ]
    }
}