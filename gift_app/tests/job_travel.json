{
    "appId": "psadil-gift_app",
    "appVersion": "0.1",
    "cmdPrefix": "ibrun -n 1 apptainer run docker://psadil/gift_app:latest --help && ibrun -n 10",
    "execSystemLogicalQueue": "corralextra",
    "coresPerNode": 10,
    "maxMinutes": 180,
    "name": "gift-travel",
    "nodeCount": 1,
    "parameterSet": {
        "appArgs": [
            {
                "arg": "--input-dirs /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/fmriprep/NStravel1/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/fmriprep/NStravel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/SH_spectrum_health/fmriprep/SHtravel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UC_uchicago/fmriprep/UCtravel1/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UC_uchicago/fmriprep/UCtravel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UI_uic/fmriprep/UItravel1/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UI_uic/fmriprep/UItravel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UM_umichigan/fmriprep/UM1travel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/UM_umichigan/fmriprep/UM2travel2/fmriprep /corral-secure/projects/A2CPS/community/resources/imaging/traveling/WS_wayne_state/fmriprep/WStravel2/fmriprep",
                "name": "INPUT_DIRS"
            },
            {
                "arg": "--output-dirs NS_northshore/gift/NStravel1 NS_northshore/gift/NStravel2 SH_spectrum_health/gift/SHtravel2 UC_uchicago/gift/UCtravel1 UC_uchicago/gift/UCtravel2 UI_uic/gift/UItravel1 UI_uic/gift/UItravel2 UM_umichigan/gift/UM1travel2 UM_umichigan/gift/UM2travel2 WS_wayne_state/gift/WStravel2",
                "name": "OUTPUT_DIRS"
            }
        ],
        "envVariables": [
            {
                "key": "FAILURE_LOG_DST",
                "value": "logs/gift/"
            },
            {
                "key": "MIN_ARCHIVE_DURATION",
                "value": "180"
            }
        ]
    }
}