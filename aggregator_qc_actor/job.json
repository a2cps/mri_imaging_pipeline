{
    "name": "aggregate_qc",
    "appId": "aggregator_qc_app",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/shared/urrutia/imaging_report",
    "archiveSystemId": "secure.frontera",
    "appVersion": "3.7",
    "parameterSet": {
        "appArgs": [
            {
                "name": "CACHED_CLIENT",
                "arg": "--cached-client $HOME/.tapis3/client.json"
            },
            {
                "name": "SECRET_NAME",
                "arg": "--secret-name a2cpsadmin-confluence-token"
            },
            {
                "name": "CONFLUENCE_USERNAME",
                "arg": "--confluence-username jurrutia@tacc.utexas.edu"
            }
        ]
    },
    "moduleLoads": [
        {
            "moduleLoadCommand": "module load",
            "modulesToLoad": [
                "tacc-apptainer"
            ]
        }
    ],
    "maxMinutes": 60,
    "subscriptions": [
        {
            "description": "Message on Failure",
            "enabled": true,
            "eventCategoryFilter": "JOB_ERROR_MESSAGE",
            "deliveryTargets": [
                {
                    "deliveryMethod": "WEBHOOK",
                    "deliveryAddress": ""
                }
            ]
        }
    ]
}