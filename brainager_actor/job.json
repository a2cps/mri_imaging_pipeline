{
    "name": "test_brainager",
    "appId": "urrutia-brainager",
    "appVersion": "0.0",
    "parameterSet": {
        "appArgs": [
            {
                "name": "INPUT_DIRS",
                "arg": "--input-dirs /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/bids/NStravel1 /corral-secure/projects/A2CPS/community/resources/imaging/traveling/NS_northshore/bids/NStravel2"
            },
            {
                "name": "OUTPUT_DIRS",
                "arg": "--output-dirs NS_northshore/brainager/NStravel1 NS_northshore/brainager/NStravel2"
            },
            {
                "name": "N_WORKERS",
                "arg": "--n-workers 5"
            }
        ],
        "envVariables": [
            {
                "key": "APPTAINERENV_OMP_NUM_THREADS",
                "value": "10"
            }
        ]
    },
    "moduleLoads": [
        {
            "moduleLoadCommand": "module load",
            "modulesToLoad": [
                "tacc-apptainer"
            ]
        }
    ],
    "hiddenOptions": [
        "MEM"
    ],
    "maxMinutes": 1440
}