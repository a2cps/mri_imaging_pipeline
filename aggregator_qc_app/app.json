{
    "containerImage": "docker://a2cps/aggregator_qc_app:3.5",
    "description": "Aggregate quality control metrics and run simple checks",
    "enabled": true,
    "id": "aggregator_qc_app",
    "version": "3.5",
    "jobAttributes": {
        "archiveOnAppError": false,
        "cmdPrefix": null,
        "description": null,
        "dynamicExecSystem": false,
        "execSystemConstraints": null,
        "execSystemExecDir": "${JobWorkingDir}",
        "execSystemId": "secure.frontera",
        "execSystemInputDir": "${JobWorkingDir}",
        "execSystemLogicalQueue": "corralextra",
        "execSystemOutputDir": "${JobWorkingDir}",
        "fileInputArrays": [],
        "fileInputs": [],
        "isMpi": false,
        "maxMinutes": 60,
        "mpiCmd": null,
        "nodeCount": 1,
        "parameterSet": {
            "appArgs": [
                {
                    "arg": "--t1w_fname /corral-secure/projects/A2CPS/products/mris/all_sites/mriqc/group_T1w.tsv",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "GROUP_T1W"
                },
                {
                    "arg": "--bold_fname /corral-secure/projects/A2CPS/products/mris/all_sites/mriqc/group_bold.tsv",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "GROUP_BOLD"
                },
                {
                    "inputMode": "INCLUDE_ON_DEMAND",
                    "name": "SECRET_NAME"
                },
                {
                    "arg": "--cached-client $HOME/.tapis3/client.json",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "CACHED_CLIENT"
                },
                {
                    "arg": "--json_dir /corral-secure/projects/A2CPS/shared/psadil/qclog/mriqc-reviews",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "JSON_DIR"
                },
                {
                    "arg": "--imaging_log /corral-secure/projects/A2CPS/shared/urrutia/imaging_report/imaging_log.csv",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "IMAGING_LOG"
                },
                {
                    "inputMode": "INCLUDE_ON_DEMAND",
                    "name": "CONFLUENCE_USERNAME"
                }
            ],
            "archiveFilter": {
                "excludes": [
                    "tapisjob.sh",
                    "${JobUUID}.out",
                    "${JobUUID}.err",
                    "tapisjob.env"
                ],
                "includeLaunchFiles": false,
                "includes": []
            },
            "logConfig": {
                "stderrFilename": "${JobUUID}.err",
                "stdoutFilename": "${JobUUID}.out"
            },
            "containerArgs": [
                {
                    "arg": "--bind /corral-secure/projects/A2CPS",
                    "description": "Mount for TAP functions",
                    "inputMode": "FIXED",
                    "name": "Container Mounts"
                }
            ],
            "envVariables": [],
            "schedulerOptions": [
                {
                    "arg": "--tapis-profile tacc-apptainer",
                    "description": "Scheduler profile for HPC clusters at TACC",
                    "inputMode": "FIXED",
                    "name": "TACC Scheduler Profile"
                },
                {
                    "arg": "--job-name ${JobName}",
                    "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
                    "inputMode": "FIXED",
                    "name": "TAP Session Substring"
                },
                {
                    "arg": "-A A2CPS",
                    "description": "The TACC allocation associated with this job execution",
                    "inputMode": "FIXED",
                    "name": "TACC Allocation"
                }
            ]
        },
        "subscriptions": [],
        "tags": []
    },
    "jobType": "BATCH",
    "maxJobs": -1,
    "maxJobsPerUser": -1,
    "owner": "${apiUserId}",
    "runtime": "SINGULARITY",
    "runtimeOptions": [
        "SINGULARITY_RUN"
    ],
    "strictFileInputs": true
}