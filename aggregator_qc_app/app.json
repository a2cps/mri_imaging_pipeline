{
  "checkpointable": false,
  "name": "{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "unload xalt",
    "load tacc-singularity"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "{{ docker.namespace }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": false,
        "required": true,
        "order": 1000
      }
    },
    {
			"id": "INROOT",
			"details":{
				"description": "root directory bound to singularity container",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/products/mris",				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
    {
			"id": "OUTROOT",
			"details":{
				"description": "root directory in which the symlinks will be created",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/products/mris/sites_all",				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
    {
			"id": "SITES",
			"details":{
				"description": "sites from from which to pull bids/mriqc",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": null,				
				"type": "string",
				"visible": true,
				"required": true
			}
		}
  ],
  "outputs": []
}
