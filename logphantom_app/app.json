{
  "checkpointable": false,
  "name": "{{ agave.username }}-{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",  
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",  
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
	"unload xalt",
    "load tacc-singularity"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "docker://{{ docker.organization }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": false,
        "required": true,
        "order": 1000
      }
    },
    {
		"id": "BIND_DIR",
		"details":{
			"description": "root directory bound to singularity container",
			"argument": "",
			"showArgument": false
		},
		"value": {
			"default": null,				
			"type": "string",
			"visible": true,
			"required": true
		}
	},
    {
		"id": "PRODUCTS",
		"details":{
			"description": "root directory where individual phantom scan derivatives are stored",
			"argument": "--products ",
			"showArgument": true
		},
		"value": {
			"default": "/corral-secure/projects/A2CPS/products/mris",				
			"type": "string",
			"visible": true,
			"required": true
		}
	},
	{
		"id": "POST",
		"details": {
			"argument": "--post",
			"showArgument": false,
			"description": "flag indicating whether to update the log on Confluence"
		},
		"value": {
			"default": false,
			"type": "flag",
			"visible": true,
			"required": false
		}
	},
    {
		"id": "URL",
		"details":{
			"description": "path of the database file to write",
			"argument": "--url ",
			"showArgument": true
		},
		"value": {
			"default": "phantom.db",				
			"type": "string",
			"visible": true,
			"required": true
		}
	}
  ],
  "outputs": []
}
