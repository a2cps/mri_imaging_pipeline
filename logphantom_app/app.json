{
  "checkpointable": false,
  "name": "{{ app.name }}",
  "executionSystem": "{{ app.execution_system }}",
  "executionType": "HPC",
  "deploymentPath": "{{ username }}/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.deployment_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "load tacc-singularity"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [    {
    "id": "input1",
    "details": {
      "label": "An input file"
    },
    "semantics": {}
  }],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "{{ docker.namespace }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": false,
        "required": true,
        "order": 1000
      }
    },
    {
			"id": "BIDS",
			"details":{
				"description": "root directory of the full bids dataset",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/community/resources/imaging/phantom/bids",				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
    {
			"id": "BIND_DIR",
			"details":{
				"description": "root directory bound to singularity container",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": null,				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
    {
			"id": "PRODUCTS",
			"details":{
				"description": "root directory where individual phantom scan derivatives are stored",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/products/mris",				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
		{
			"id": "POST",
			"details": {
				"argument": "",
				"showArgument": false,
				"description": "flag indicating whether to update the log on Confluence"
			},
			"value": {
				"default": "--no-post",
				"type": "enumeration",
				"enumValues": ["--post", "--no-post"],
				"visible": true,
				"required": false
			}
		}
  ],
  "outputs": []
}
