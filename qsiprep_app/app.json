{
	"name": "{{ agave.username }}-{{ app.name }}",
	"version": "{{ app.version }}",
	"executionType": "HPC",
	"executionSystem": "{{ app.hpc_system}}",
	"parallelism": "SERIAL",
	"deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
	"deploymentSystem": "{{ app.storage_system}}",
	"defaultProcessorsPerNode": 1,
	"defaultNodeCount": 1,
	"defaultQueue": "{{ app.queue }}",
	"label": "qsiprep",
	"modules": [
		"unload xalt",
		"load tacc-singularity",
		"load python3",
		"load launcher"
	],
	"shortDescription": "{{ app.description }}",
	"templatePath": "runner-template.sh",
	"testPath": "tester.sh",
	"inputs": [],
	"parameters": [
		{
			"id": "CONTAINER_IMAGE",
			"value": {
				"default": "{{ docker.organization }}/{{ docker.repo }}:{{ docker.tag }}",
				"description": "Container Image. Do not edit.",
				"type": "string",
				"visible": false,
				"required": true
			}
		},
		{
			"id": "BIDS",
			"value": {
				"default": "",
				"visible": true,
				"type": "string",
				"required": true
			},
			"details": {
				"description": "Directory containing files to analyze",
				"showArgument": false
			},
			"semantics": {
				"minCardinality": 1,
				"maxCardinality": -1
			}
		},
		{
			"id": "OUTDIR",
			"value": {
				"default": "",
				"visible": true,
				"type": "string",
				"required": true
			},
			"details": {
				"description": "Comma separated list of directories to which results will be written",
				"showArgument": false
			},
			"semantics": {
				"minCardinality": 1,
				"maxCardinality": -1
			}
		},
		{
			"id": "BIND_DIR",
			"value": {
				"default": null,
				"description": "Binds the directory in the container",
				"type": "string",
				"visible": true,
				"required": true
			}
		},
		{
			"id": "MEMMB",
			"details": {
				"argument": "--mem-mb ",
				"showArgument": true
			},
			"value": {
				"default": 190000,
				"description": "Maximum amount of MB available to QSIprep when processing each participant",
				"type": "number",
				"visible": true,
				"required": true
			}
		},
		{
			"id": "NTHREADS",
			"details": {
				"argument": "--nthreads ",
				"showArgument": true
			},
			"value": {
				"default": 56,
				"description": "Maximum number of threads available to QSIprep when processing each participant",
				"type": "number",
				"visible": true,
				"required": true
			}
		}
	]
}