{
  "checkpointable": false,
  "name": "{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",  
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "unload xalt",
    "load tacc-singularity"
  ],  
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [ ],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "{{ docker.namespace }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": false,
        "required": true,
        "order": 1000
      }
    },
    {
      "id": "BIND_DIR",
      "value": {
        "default": "/corral-secure/projects/A2CPS",
        "type": "string",
        "required": true,
        "order": 1000
      }
    },
    {
      "id": "INROOT",
      "value": {
        "default": "/corral-secure/projects/A2CPS/products/mris",
        "type": "string",
        "required": true,
        "order": 1000
      }
    },
    {
      "id": "OUTDIR",
      "value": {
        "default": "/corral-secure/projects/A2CPS/resources/imaging/phantom/bids",
        "type": "string",
        "required": true,
        "order": 1000
      }
    }
  ],
  "outputs": []
}
