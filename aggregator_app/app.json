{
    "containerImage": "docker://a2cps/aggregator:2.7",
    "version": "2.7",
    "description": "Stage MRI Products for Release",
    "enabled": true,
    "id": "aggregator",
    "jobAttributes": {
        "archiveOnAppError": false,
        "archiveSystemDir": "${JobWorkingDir}",
        "cmdPrefix": null,
        "description": null,
        "dynamicExecSystem": false,
        "execSystemConstraints": null,
        "execSystemExecDir": "${JobWorkingDir}",
        "execSystemId": "secure.frontera",
        "execSystemInputDir": "${JobWorkingDir}",
        "execSystemLogicalQueue": "corralextra",
        "execSystemOutputDir": "${JobWorkingDir}",
        "fileInputArrays": [],
        "fileInputs": [],
        "isMpi": false,
        "maxMinutes": 120,
        "mpiCmd": null,
        "nodeCount": 1,
        "parameterSet": {
            "appArgs": [
                {
                    "arg": null,
                    "inputMode": "REQUIRED",
                    "name": "INROOT"
                },
                {
                    "arg": null,
                    "inputMode": "REQUIRED",
                    "name": "OUTROOT"
                },
                {
                    "arg": null,
                    "inputMode": "INCLUDE_ON_DEMAND",
                    "name": "MAXSUBS"
                },
                {
                    "arg": "--n-threads 16",
                    "description": "Number of threads used during synthstrip",
                    "inputMode": "INCLUDE_BY_DEFAULT",
                    "name": "NTHREADS"
                },
                {
                    "arg": "--tidy",
                    "description": "Whether to tidy output directory (from previous archive)",
                    "inputMode": "INCLUDE_ON_DEMAND",
                    "name": "TIDY"
                }
            ],
            "archiveFilter": {
                "excludes": [
                    "tapisjob.sh",
                    "${JobUUID}.out",
                    "${JobUUID}.err",
                    "tapisjob.env"
                ],
                "includeLaunchFiles": false,
                "includes": []
            },
            "logConfig": {
                "stderrFilename": "${JobUUID}.err",
                "stdoutFilename": "${JobUUID}.out"
            },
            "containerArgs": [
                {
                    "arg": "--bind /corral-secure/projects/A2CPS",
                    "description": "Mount for TAP functions",
                    "inputMode": "FIXED",
                    "name": "Container Mounts"
                }
            ],
            "envVariables": [],
            "schedulerOptions": [
                {
                    "arg": "--tapis-profile tacc-apptainer",
                    "description": "Scheduler profile for HPC clusters at TACC",
                    "inputMode": "FIXED",
                    "name": "TACC Scheduler Profile"
                },
                {
                    "arg": "--job-name ${JobName}",
                    "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
                    "inputMode": "FIXED",
                    "name": "TAP Session Substring"
                },
                {
                    "arg": "-A A2CPS",
                    "description": "The TACC allocation associated with this job execution",
                    "inputMode": "FIXED",
                    "name": "TACC Allocation"
                }
            ]
        },
        "subscriptions": [],
        "tags": []
    },
    "jobType": "BATCH",
    "maxJobs": -1,
    "maxJobsPerUser": -1,
    "owner": "${apiUserId}",
    "runtime": "SINGULARITY",
    "runtimeOptions": [
        "SINGULARITY_RUN"
    ],
    "runtimeVersion": null,
    "strictFileInputs": true
}