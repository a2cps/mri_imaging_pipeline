{
    "name": "test_fcn",
    "appId": "functional-connectivity",
    "appVersion": "0.1",
    "archiveSystemDir": "${JobWorkingDir}",
    "parameterSet": {
        "appArgs": [
            {
                "name": "FMRIPREP_DIR",
                "arg": "--fmriprep-dir /corral-secure/projects/A2CPS/shared/psadil/traveling/mris/NS_northshore/fmriprep/NStravel1/rest/fmriprep /corral-secure/projects/A2CPS/shared/psadil/traveling/mris/NS_northshore/fmriprep/NStravel1/cuff/fmriprep"
            },
            {
                "name": "OUTPUT_DIR",
                "arg": "--output-dir NS_northsthore/fcn/travel1 NS_northsthore/fcn/travel1"
            },
            {
                "name": "N_WORKERS",
                "arg": "--n-workers 8"
            }
        ]
    },
    "moduleLoads": [
        {
            "moduleLoadCommand": "module load",
            "modulesToLoad": [
                "tacc-apptainer"
            ]
        }
    ],
    "hiddenOptions": [
        "MEM"
    ],
    "maxMinutes": 1440
}