{
    "appId": "qsiprep-app",
    "appVersion": "3.2",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/products/mris/",
    "cmdPrefix": "ibrun -n 1",
    "coresPerNode": 1,
    "maxMinutes": 360,
    "name": "qsiprep",
    "nodeCount": 1,
    "parameterSet": {
        "appArgs": [
            {
                "arg": "--bidsdir /corral-secure/projects/A2CPS/shared/psadil/jobs/travel-bids/NS_northshore/bids/NStravel1 ",
                "name": "BIDSDIR"
            },
            {
                "arg": "--nthreads 10",
                "name": "NTHREADS"
            },
            {
                "arg": "--mem-mb 21333",
                "name": "MEM_MB"
            }
        ],
        "envVariables": [
            {
                "key": "FAILURE_LOG_DST",
                "value": "/corral-secure/projects/A2CPS/products/development/mris/logs/qsiprep/"
            }
        ]
    },
    "subscriptions": [
        {
            "deliveryTargets": [
                {
                    "deliveryAddress": "",
                    "deliveryMethod": "WEBHOOK"
                }
            ],
            "description": "Message on Failure",
            "enabled": true,
            "eventCategoryFilter": "JOB_ERROR_MESSAGE"
        }
    ]
}