{
    "appId": "qsiprep",
    "appVersion": "3.3",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/products/mris/",
    "archiveSystemId": "secure.frontera",
    "cmdPrefix": "ibrun -n 1",
    "coresPerNode": 1,
    "maxMinutes": 1140,
    "name": "qsiprep",
    "nodeCount": 1,
    "parameterSet": {
        "appArgs": [
            {
                "arg": "--input-dirs /corral-secure/projects/A2CPS/products/mris/NS_northshore/bids/NS11397V1 ",
                "name": "INPUT_DIRS"
            },
            {
                "arg": "--n-workers 9",
                "name": "N_WORKERS"
            },
            {
                "arg": "--mem-mb 32000",
                "name": "MEM_MB"
            },
            {
                "arg": "--job qsiprep-v4",
                "name": "JOB"
            }
        ],
        "envVariables": [
            {
                "key": "FAILURE_LOG_DST",
                "value": "/corral-secure/projects/A2CPS/products/development/mris/logs/qsiprep-v4/"
            }
        ]
    },
    "subscriptions": [
        {
            "deliveryTargets": [
                {
                    "deliveryAddress": "",
                    "deliveryMethod": "WEBHOOK"
                }
            ],
            "description": "Message on Failure",
            "enabled": true,
            "eventCategoryFilter": "JOB_ERROR_MESSAGE"
        }
    ]
}