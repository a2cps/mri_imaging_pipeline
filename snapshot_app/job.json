{
    "name": "test_snapshot",
    "appId": "psadil-snapshot_app",
    "appVersion": "0.1",
    "archiveSystemDir": "${JobWorkingDir}",
    "parameterSet": {
        "appArgs": [
            {
                "name": "INROOT",
                "arg": "--inroot /corral-secure/projects/A2CPS/shared/psadil/jobs/8d04d3cf-f3b4-467d-95db-180be35f9c7e-007/all_sites"
            },
            {
                "name": "OUTROOT",
                "arg": "--outroot $PWD/store"
            },
            {
                "name": "RIADIR",
                "arg": "--riadir $PWD/ria"
            },
            {
                "name": "N_WORKERS",
                "arg": "--n-workers 48"
            }
        ]
    },
    "moduleLoads": [
        {
            "moduleLoadCommand": "module load",
            "modulesToLoad": [
                "tacc-apptainer"
            ]
        }
    ],
    "hiddenOptions": [
        "MEM"
    ],
    "maxMinutes": 2880
}