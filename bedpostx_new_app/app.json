{
  "id": "maj-bedpostx_new_app",
  "version": "3.0",
  "description": "Modeling diffusion profile prior to tractography",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": [
    "SINGULARITY_RUN"
  ],
  "containerImage": "docker://micaceous/bedpostx_new_app",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": true,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "secure.frontera",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemOutputDir": "${JobWorkingDir}",
    "execSystemLogicalQueue": "rtx-corralextra",
    "archiveSystemId": "secure.frontera",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/shared/maj/bedpostx_new_app",
    "archiveOnAppError": false,
    "isMpi": false,
    "mpiCmd": null,
    "cmdPrefix": null,
    "parameterSet": {
      "appArgs": [
        {
          "name": "PARTICIPANT_LABEL",
          "arg": "sub-20064"
        },
        {
          "name": "SESSION_LABEL",
          "arg": "ses-V1"
        },
        {
          "name": "QSIRECONDIR",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/qsirecon-fsl_dtifit_app/derivatives/qsirecon-FSL"
        },
        {
          "name": "OUTDIR",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/bedpostx_new_app/derivatives"
        }
      ],
      "containerArgs": [
        {
          "name": "Container Mounts",
          "description": "Mount for TAP functions",
          "inputMode": "FIXED",
          "arg": "--bind /corral-secure/projects/A2CPS"
        }
      ],
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "description": "Scheduler profile for HPC clusters at TACC",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer"
        },
        {
          "name": "TAP Session Substring",
          "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
          "inputMode": "FIXED",
          "arg": "--job-name ${JobName}"
        },
        {
          "name": "TACC Allocation",
          "description": "The TACC allocation associated with this job execution",
          "inputMode": "FIXED",
          "arg": "-A A2CPS"
        }
      ],
      "envVariables": [],
      "archiveFilter": {
        "includes": [],
        "excludes": [
          "*out"
        ],
        "includeLaunchFiles": false
      }
    },
    "fileInputs": [],
    "fileInputArrays": [],
    "nodeCount": 1,
    "maxMinutes": 180,
    "subscriptions": [],
    "tags": []
  }
}