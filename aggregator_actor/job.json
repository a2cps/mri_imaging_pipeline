{
    "name": "aggregate",
    "appId": "aggregator",
    "appVersion": "2.0",
    "parameterSet": {
        "appArgs": [
            {
                "name": "INROOT",
                "arg": "/corral-secure/projects/A2CPS/products/mris"
            },
            {
                "name": "OUTROOT",
                "arg": "/corral-secure/projects/A2CPS/products/mris/all_sites"
