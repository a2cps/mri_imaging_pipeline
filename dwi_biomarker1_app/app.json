{
  "containerImage": "docker://a2cps/dwi_biomarker1_app:0.1",
  "description": "Tractography and biomarker estimation",
  "enabled": true,
  "id": "dwi-biomarker1-app",
  "version": "0.1",
  "jobAttributes": {
    "archiveOnAppError": false,
    "cmdPrefix": "ibrun -n 1",
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemId": "secure.ls6",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemLogicalQueue": "corralextra",
    "execSystemOutputDir": "${JobWorkingDir}",
    "fileInputArrays": [],
    "fileInputs": [],
    "maxMinutes": 120,
    "mpiCmd": null,
    "nodeCount": 1,
    "parameterSet": {
      "appArgs": [
        {
          "arg": null,
          "inputMode": "REQUIRED",
          "name": "INPUT_DIRS"
        },
        {
          "arg": null,
          "inputMode": "INCLUDE_ON_DEMAND",
          "name": "PARTICIPANT_LABELS"
        },
        {
          "arg": null,
          "inputMode": "INCLUDE_ON_DEMAND",
          "name": "SES_LABELS"
        },
        {
          "arg": null,
          "inputMode": "INCLUDE_ON_DEMAND",
          "name": "BEDPOSTX_DIRS"
        },
        {
          "arg": null,
          "inputMode": "INCLUDE_ON_DEMAND",
          "name": "OUTPUT_DIRS"
        },
        {
          "arg": "--n-workers 1",
          "inputMode": "INCLUDE_ON_DEMAND",
          "name": "N_WORKERS"
        }
      ],
      "archiveFilter": {
        "excludes": [
          "tapisjob.sh",
          "${JobUUID}.out",
          "${JobUUID}.err",
          "tapisjob.env"
        ],
        "includeLaunchFiles": false,
        "includes": []
      },
      "containerArgs": [
        {
          "arg": "--bind /corral-secure/projects/A2CPS",
          "description": "Mount for TAP functions",
          "inputMode": "FIXED",
          "name": "Container Mounts"
        }
      ],
      "envVariables": [],
      "logConfig": {
        "stderrFilename": "${JobUUID}.err",
        "stdoutFilename": "${JobUUID}.out"
      },
      "schedulerOptions": [
        {
          "arg": "--tapis-profile ls6-mpi",
          "description": "Scheduler profile for HPC clusters at TACC",
          "inputMode": "FIXED",
          "name": "TACC Scheduler Profile"
        },
        {
          "arg": "--job-name ${JobName}",
          "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
          "inputMode": "FIXED",
          "name": "TAP Session Substring"
        },
        {
          "arg": "-A A2CPS",
          "description": "The TACC allocation associated with this job execution",
          "inputMode": "FIXED",
          "name": "TACC Allocation"
        }
      ]
    },
    "subscriptions": [],
    "tags": []
  },
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "owner": "${apiUserId}",
  "runtime": "SINGULARITY",
  "runtimeOptions": [
    "SINGULARITY_RUN"
  ],
  "strictFileInputs": true
}