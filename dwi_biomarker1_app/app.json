{
  "id": "maj-dwi_biomarker1_app",
  "version": "0.1",
  "description": "Tractography and biomarker estimation",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "SINGULARITY",
  "runtimeVersion": null,
  "runtimeOptions": [
    "SINGULARITY_RUN"
  ],
  "containerImage": "docker://micaceous/dwi_biomarker1_app",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": -1,
  "strictFileInputs": true,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "secure.frontera",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}",
    "execSystemOutputDir": "${JobWorkingDir}",
    "execSystemLogicalQueue": "corralextra",
    "archiveSystemId": "secure.frontera",
    "archiveSystemDir": "/corral-secure/projects/A2CPS/shared/maj/dwi_biomarker1_app",
    "archiveOnAppError": false,
    "isMpi": false,
    "mpiCmd": null,
    "cmdPrefix": null,
    "parameterSet": {
      "appArgs": [
        {
          "name": "PARTICIPANT_LABEL",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "sub-10042"
        },
        {
          "name": "SESSION_LABEL",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "ses-V1"
        },
        {
          "name": "QSIPREPDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/products/mris/NS_northshore/qsiprep/NS10042V1/qsiprep"
        },
        {
          "name": "BEDPOSTXDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/products/mris/NS_northshore/bedpostx/NS10042V1/bedpostx"
        },
        {
          "name": "QSIRECONDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/products/mris/NS_northshore/qsirecon_fsl_dtifit/NS10042V1/qsirecon-fsl/derivatives/qsirecon-FSL"
        },
        {
          "name": "ROIPREPDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/DWI_Biomarker-1/prepare_ROIs-VP"
        },
        {
          "name": "OUTDIR",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/dwi_biomarker1_app/derivatives"
        },
        {
          "name": "LICENSE",
          "inputMode": "INCLUDE_BY_DEFAULT",
          "arg": "/corral-secure/projects/A2CPS/shared/maj/qsiprep_tests/code/license.txt"
        }
      ],
      "containerArgs": [
        {
          "name": "Container Mounts",
          "description": "Mount for TAP functions",
          "inputMode": "FIXED",
          "arg": "--bind /corral-secure/projects/A2CPS"
        }
      ],
      "schedulerOptions": [
        {
          "name": "TACC Scheduler Profile",
          "description": "Scheduler profile for HPC clusters at TACC",
          "inputMode": "FIXED",
          "arg": "--tapis-profile tacc-apptainer"
        },
        {
          "name": "TAP Session Substring",
          "description": "TAP Functions require the substring 'tap_' and in the slurm job name in order to function.",
          "inputMode": "FIXED",
          "arg": "--job-name ${JobName}"
        },
        {
          "name": "TACC Allocation",
          "description": "The TACC allocation associated with this job execution",
          "inputMode": "FIXED",
          "arg": "-A A2CPS"
        }
      ],
      "envVariables": [],
      "archiveFilter": {
        "includes": [],
        "excludes": [
          "*out"
        ],
        "includeLaunchFiles": false
      }
    },
    "fileInputs": [],
    "fileInputArrays": [],
    "nodeCount": 1,
    "maxMinutes": 120,
    "subscriptions": [],
    "tags": []
  }
}