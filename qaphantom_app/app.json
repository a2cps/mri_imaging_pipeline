{
  "checkpointable": false, 
  "name": "{{ agave.username }}-{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "unload xalt",
    "load launcher",
    "load tacc-singularity",
    "load python3/3.9.2"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [ ],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "docker://{{ docker.namespace }}/{{ docker.repo }}:{{ docker.tag }}",
        "type": "string",
        "visible": false,
        "required": true,
        "order": 1000
      }
    },
    {
      "id": "BIND_DIR",
      "value": {
        "default": "/corral-secure/projects/A2CPS/",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "argument": "--bind-dir ",
        "description": "Directory that is mounted into the container",
        "showArgument": true
      }
    },
    {
      "id": "BIDS",
      "value": {
        "default": "",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Directory containing niftis (will search for files recursively)",
        "showArgument": false
      },
      "semantics": {
        "minCardinality": 1,
        "maxCardinality": -1
      }
    },
    {
      "id": "OUTDIR",
      "value": {
        "default": "",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Comma separated list of directories to which results will be written",
        "showArgument": false
      },
      "semantics": {
        "minCardinality": 1,
        "maxCardinality": -1
      }
    }
  ],
  "outputs": []
}
