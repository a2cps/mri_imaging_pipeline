{
  "checkpointable": false,
  "name": "{{ app.name }}",
  "executionSystem": "{{ app.hpc_system }}",
  "executionType": "HPC",
  "defaultQueue": "{{ app.queue }}",
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system }}",
  "helpURI": "",
  "label": "{{ app.label }}",
  "shortDescription": "{{ app.description }}",
  "longDescription": "",
  "modules": [
    "unload xalt",
    "load python3/3.9.2"
  ],
  "ontology": [],
  "parallelism": "SERIAL",
  "tags": [],
  "templatePath": "runner.sh",
  "testPath": "tester.sh",
  "version": "{{ app.version }}",
  "defaultMaxRunTime": "00:30:00",
  "inputs": [],
  "parameters": [
    {
			"id": "INROOT",
			"details":{
				"description": "root directory bound to singularity container",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/products/mris",				
				"type": "string",
				"visible": true,
				"required": true
			}
		},
    {
			"id": "OUTDIR",
			"details":{
				"description": "directory in which the symlinks will be created",
				"argument": "",
				"showArgument": false
			},
			"value": {
				"default": "/corral-secure/projects/A2CPS/products/mris/all_sites/bids/a2cps",				
				"type": "string",
				"visible": true,
				"required": true
			}
		}
  ],
  "outputs": []
}
