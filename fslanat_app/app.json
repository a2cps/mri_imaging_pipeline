{
  "name": "{{ agave.username }}-{{ app.name }}",
  "version": "{{ app.version }}",
  "executionType": "HPC",
  "executionSystem": "{{ app.hpc_system}}",
  "parallelism": "SERIAL",
  "deploymentPath": "system/apps/{{ app.name }}-{{ app.version }}",
  "deploymentSystem": "{{ app.storage_system}}",
  "defaultProcessorsPerNode": 40,
  "defaultNodeCount": 1,
  "defaultQueue": "{{ app.queue }}",
  "label": "fMRIPRep",
  "modules": [
    "load launcher",
    "load python3/3.9.2",
    "load tacc-singularity",
    "unload xalt"
  ],
  "shortDescription": "{{ app.description }}",
  "templatePath": "runner-template.sh",
  "testPath": "tester.sh",
  "inputs": [],
  "parameters": [
    {
      "id": "CONTAINER_IMAGE",
      "value": {
        "default": "{{ docker.organization }}/{{ docker.repo }}:{{ docker.tag }}",
        "description": "Container Image. Do not edit.",
        "type": "string",
        "visible": false,
        "required": true
      }
    },
    {
      "id": "BINDDIR",
      "value": {
        "default": "/corral-secure/projects/A2CPS",
        "visible": true,
        "type": "string",
        "required": true
      },
      "details": {
        "description": "Directory which will be bound inside the singularity container",
        "showArgument": false
      }
    },
    {
      "id": "BIDS_DIR",
      "value": {
        "default": "--bids-dir",
        "visible": true,
        "type": "string",
        "required": true
      },
      "semantics": {
        "ontology": [
          "https://bids.neuroimaging.io/specification.html"
        ],
        "minCardinality": 1,
        "maxCardinality": -1
      },
      "details": {
        "description": "The root folder of a BIDS valid dataset (sub-XXXXX folders should be found at the top level in this folder).",
        "showArgument": false
      }
    },
    {
      "id": "OUTPUT_DIR",
      "details": {
        "description": "The output directory name for the outcomes of preprocessing and visual reports",
        "showArgument": false
      },
      "value": {
        "default": "--output-dir",
        "visible": true,
        "type": "string",
        "required": true
      },
      "semantics": {
        "minCardinality": 1,
        "maxCardinality": -1
      }
    },
    {
      "id": "N_WORKERS",
      "details": {
        "argument": "--n-workers ",
        "showArgument": true
      },
      "value": {
        "default": 1,
        "description": "Maximum number of participants that will be processed in parallel",
        "type": "number",
        "visible": true,
        "required": true
      }
    }
  ]
}